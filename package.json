{
  "name": "@kira905/dsh-butler-panel",
  "version": "0.9.1",
  "description": "大管家的可视化面板：在 DSH 侧边栏看今天该看什么（结论 / 待处理 / 资产 / 流水 / 健康），只读为主；另带 P5 写入守门人（可挂可摘）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "butler",
    "panel",
    "dashboard",
    "task-board",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira905/dsh-butler-panel.git"
  },
  "homepage": "https://github.com/kira905/dsh-butler-panel#readme",
  "bugs": {
    "url": "https://github.com/kira905/dsh-butler-panel/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dsh-host-adapter-client": "npm:@kira905/dsh-host-adapter-client@^0.1.2"
  },
  "peerDependencies": {},
  "license": "AGPL-3.0-only",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "dsh-host-adapter-client"
      ],
      "inject": [],
      "platform": "web"
    }
  }
}
